<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
        android:key="download_location"
        android:title="@string/settings_download_download_location"
        app:iconSpaceReserved="false" />

    <Preference android:key="download_storage" android:title="@string/ad_storage_title"
        android:selectable="false" app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:key="media_scan"
        android:title="@string/settings_download_media_scan"
        app:iconSpaceReserved="false"
        app:summaryOff="@string/settings_download_media_scan_summary_off"
        app:summaryOn="@string/settings_download_media_scan_summary_on" />

    <rikka.preference.SimpleMenuPreference
        android:defaultValue="3"
        android:key="download_thread"
        android:title="@string/settings_download_concurrency"
        app:entries="@array/multi_thread_download_entries"
        app:entryValues="@array/multi_thread_download_entry_values"
        app:iconSpaceReserved="false" />

    <rikka.preference.SimpleMenuPreference
        android:defaultValue="1000"
        android:key="download_delay_2"
        android:title="@string/settings_download_download_delay"
        app:entries="@array/download_delay_entries"
        app:entryValues="@array/download_delay_entry_values"
        app:iconSpaceReserved="false" />

    <SeekBarPreference
        android:defaultValue="60"
        android:key="download_timeout"
        android:max="120"
        android:title="@string/settings_download_download_timeout"
        app:iconSpaceReserved="false"
        app:min="20"
        app:showSeekBarValue="true"
        app:singleLineTitle="false" />

    <rikka.preference.SimpleMenuPreference
        android:defaultValue="5"
        android:key="preload_image"
        android:title="@string/settings_download_preload_image"
        app:entries="@array/preload_image_entries"
        app:entryValues="@array/preload_image_entry_values"
        app:iconSpaceReserved="false" />

    <rikka.preference.SimpleMenuPreference
        android:defaultValue="0"
        android:key="download_origin_image_"
        android:title="@string/settings_download_download_origin_image"
        app:entries="@array/download_origin_image_entries"
        app:entryValues="@array/download_origin_image_entry_values"
        app:iconSpaceReserved="false" />

    <com.hippo.ehviewer.preference.RestoreDownloadPreference
        android:key="restore_download_items"
        android:summary="@string/settings_download_restore_download_items_summary"
        android:title="@string/settings_download_restore_download_items"
        app:iconSpaceReserved="false" />

    <com.hippo.ehviewer.preference.CleanRedundancyPreference
        android:key="clean_redundancy"
        android:summary="@string/settings_download_clean_redundancy_summary"
        android:title="@string/settings_download_clean_redundancy"
        app:iconSpaceReserved="false" />

    <PreferenceCategory android:title="@string/tag_database" app:iconSpaceReserved="false" android:layout="@layout/preference_tag_category">
        <SwitchPreferenceCompat android:key="tag_auto_sync" android:defaultValue="true" android:title="@string/tag_auto_sync" app:iconSpaceReserved="false" />
        <Preference android:key="tag_status" android:title="@string/tag_status" app:iconSpaceReserved="false" />
        <Preference android:key="tag_fill" android:title="@string/tag_fill" app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat android:key="tag_sync_paused" android:defaultValue="false" android:title="@string/tag_pause" app:iconSpaceReserved="false" />
        <Preference android:key="tag_retry" android:title="@string/tag_retry" app:iconSpaceReserved="false" />
        <Preference android:key="tag_refresh" android:title="@string/tag_refresh" android:summary="@string/tag_refresh_summary" app:iconSpaceReserved="false" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/ad_settings" app:iconSpaceReserved="false" android:layout="@layout/preference_tag_category">
        <SwitchPreferenceCompat android:key="ad_auto" android:defaultValue="false" android:title="@string/ad_auto" android:summary="@string/ad_auto_summary" app:iconSpaceReserved="false" />
        <Preference android:key="ad_clean_all" android:title="@string/ad_clean_all" android:summary="@string/ad_clean_all_summary" app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat android:key="ad_paused" android:defaultValue="false" android:title="@string/ad_pause" app:iconSpaceReserved="false" />
        <Preference android:key="ad_status" android:title="@string/ad_status" android:selectable="false" app:iconSpaceReserved="false" />
    </PreferenceCategory>
</PreferenceScreen>
